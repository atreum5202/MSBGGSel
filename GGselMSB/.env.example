# ════════════════════════════════════════════════════════════════════════
#  GGselV7 / GgsellerMoreLogin — шаблон .env
#  Скопируй в .env и заполни свои ключи.
#  В .env реальные ключи — НЕ КОММИТЬ.
# ════════════════════════════════════════════════════════════════════════

# === MoreLogin (ОСНОВНОЙ антидетект на этой ветке) ===
# Получить: MoreLogin Desktop → Settings (⚙️) → API → Enable API
MORELOGIN_API_BASE=http://127.0.0.1:40000
MORELOGIN_API_ID=
MORELOGIN_API_KEY=
# Конкретные профили (envId через запятую) — пусто = все из группы ниже
MORELOGIN_PROFILE_IDS=
# Имя группы в MoreLogin (создай заранее в UI)
MORELOGIN_GROUP_NAME=GGSeller
# Cookie TTL (сек) — после скольки секунд куки считать протухшими
MORELOGIN_COOKIE_TTL=900
# Headless режим для /api/env/start (нужен MoreLogin v2.36.0+)
MORELOGIN_HEADLESS=false
# Включить cdpEvasion (v2.36.0+, снижает риск детекта CDP)
MORELOGIN_CDP_EVASION=true
# Таймаут открытия профиля (сек)
MORELOGIN_OPEN_TIMEOUT=30
# CDP-таймаут на одну команду (сек)
MORELOGIN_CDP_TIMEOUT=10

# === MSB (ЗАПАСНОЙ — НЕ ТРОГАТЬ, для будущего возврата) ===
# Если MORELOGIN_API_ID/KEY пусты и заполнены MSB_* —
# ANTIDETECT_BACKEND автоматически станет "msb".
MSB_API_BASE=http://127.0.0.1:17248
MSB_API_TOKEN=
MSB_PROFILE_IDS=
MSB_COOKIE_TTL=900
MSB_SCENARIO_TIMEOUT_MS=45000

# === GGSEL (продавец ggsel.net) ===
GGSEL_API_KEY=your_seller_api_key_here
GGSEL_SELLER_ID=123456

# === Локальный Flask-сервер ===
LOCAL_PORT=5000

# === Парсер ===
PARSER_WORKERS=3
PARSER_DELAY_MIN=2
PARSER_DELAY_MAX=7

# === Прогрев профилей ===
WARM_POLL_INTERVAL=5
WARM_TIMEOUT=600

# === Telegram-бот (опционально) ===
TG_BOT_TOKEN=
TG_CHAT_ID=

# === Прокси для парсера (socks5/http через запятую) ===
PARSER_PROXIES=

# === Разное ===
FLASK_DEBUG=false
LOG_LEVEL=INFO
