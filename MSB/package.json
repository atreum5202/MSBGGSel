{
  "name": "msb",
  "version": "1.2.0",
  "description": "Antidetect browser profile manager (CloakBrowser + Patchright) with REST API, WebContentsView preview, cookie/CRX management",
  "main": "src/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "echo skipping playwright install",
    "dev:renderer": "npx --yes vite",
    "build:renderer": "npx --yes vite build",
    "dev": "concurrently -k -n vite,electron -c blue,green \"npx --yes vite\" \"wait-on http://localhost:5173 && cross-env MSB_VITE_URL=http://localhost:5173 NODE_ENV=development electron .\"",
    "dev:headless": "concurrently -k -n vite,electron -c blue,green \"npx --yes vite\" \"wait-on http://localhost:5173 && cross-env MSB_VITE_URL=http://localhost:5173 MSB_HEADLESS=1 NODE_ENV=development electron .\"",
    "start": "electron .",
    "start:headless": "npm run build:renderer && cross-env MSB_HEADLESS=1 electron .",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder",
    "clean": "rimraf dist release",
    "test": "node --test tests/**/*.test.js"
  },
  "keywords": [
    "antidetect",
    "electron",
    "cloakbrowser",
    "patchright",
    "wayfern",
    "stealth",
    "playwright"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.1",
    "adm-zip": "^0.6.0",
    "cloakbrowser": "^0.4.5",
    "fastify": "^5.1.0",
    "https-proxy-agent": "^7.0.5",
    "mmdb-lib": "^2.0.0",
    "patchright": "^1.61.1",
    "playwright-core": "^1.53.0",
    "puppeteer-core": "^21.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "socks-proxy-agent": "^10.0.0",
    "sql.js": "^1.14.1",
    "undici": "^7.28.0",
    "uuid": "^11.0.0",
    "vite": "^5.4.11",
    "wayfern": "^0.1.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "crawlee": "^3.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
