# MSB Standalone — переменные окружения
# Скопируй в .env и заполни нужные значения.

# Порт API (GGSel и Panel ждут 17248)
MSB_API_PORT=17248

# Токен авторизации — оставь пустым чтобы отключить проверку
MSB_API_TOKEN=

# Профили хранятся в APPDATA — общее место для Panel и MSB
MSB_PROFILES_DIR=%APPDATA%\MSB\profiles

# Папка логов
MSB_LOG_DIR=%APPDATA%\MSB\logs

# Папка загрузок (пусто = стандартная папка Downloads Windows)
MSB_DOWNLOADS_DIR=

MSB_LOG_LEVEL=info
NODE_ENV=production
